{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julia-runtime.local/schemas/CognitiveTurn.schema.json",
  "title": "CognitiveTurn",
  "description": "Complete cognitive turn object: RuntimeEnvelope + JuliaContext v2. RuntimeEnvelope is program-facing; JuliaContext is model-facing.",
