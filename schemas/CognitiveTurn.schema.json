  "required": ["runtime_envelope", "julia_context"],
  "properties": {
    "runtime_envelope": {
      "$ref": "RuntimeEnvelope.schema.json"
    },
    "julia_context": {
      "$ref": "JuliaContext_v2.schema.json"
    }
  }
}
